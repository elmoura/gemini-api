doctype
html(lang='pt-BR')
  head
    meta(charset='utf-8')
    title Convite Chefin
  body(style='margin:0;padding:0;background-color:#f5f5f5;font-family:Arial,Helvetica,sans-serif;')
    table(width='100%' cellpadding='0' cellspacing='0' style='padding:32px 16px;')
      tr
        td(align='center')
          table(width='480' cellpadding='0' cellspacing='0' style='background-color:#ffffff;border-radius:8px;padding:32px;')
            tr
              td
                h1(style='font-size:20px;color:#1a1a1a;margin:0 0 16px;') Você foi convidado para o Chefin
                p(style='font-size:14px;color:#4a4a4a;line-height:1.5;margin:0 0 24px;')
                  | Clique no botão abaixo para criar sua senha e acessar a plataforma.
                table(cellpadding='0' cellspacing='0')
                  tr
                    td(style='border-radius:6px;background-color:#1a1a1a;')
                      a(href=invitationUrl style='display:inline-block;padding:12px 24px;font-size:14px;color:#ffffff;text-decoration:none;') Aceitar convite
                p(style='font-size:12px;color:#8a8a8a;line-height:1.5;margin:24px 0 0;')
                  | Se o botão não funcionar, copie e cole este link no navegador:
                  br
                  a(href=invitationUrl style='color:#4a4a4a;word-break:break-all;')= invitationUrl
                p(style='font-size:12px;color:#8a8a8a;line-height:1.5;margin:16px 0 0;')
                  | Este convite expira em 7 dias.
